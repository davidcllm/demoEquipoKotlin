<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="?android:attr/actionBarSize"
    tools:context="david.ceballos.helloworld.scenes.list.view.ListFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header1"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ic_back_register"
            android:layout_width="20dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Noticias"
            android:textStyle="bold"
            android:textSize="20sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ImageView
            android:id="@+id/ic_logo"
            android:layout_width="40dp"
            android:layout_height="0dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_logo_news"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/header2"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/header1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ic_search"
            android:layout_width="20dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/ic_search" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Buscar"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:textStyle="bold"
            android:textSize="20dp" />

    </LinearLayout>


    <!--falta implementar el scroll view-->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header2">



    </ScrollView>

    <com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/noticia1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:strokeColor="#E0E0E0"
        app:strokeWidth="1dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/header2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- aqui vendra la imagen del noticiero -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:backgroundTint="#D1C4E9"
                android:src="@android:color/transparent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!--De momento ponemos un text view-->
            <TextView
                android:id="@+id/txtInitial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A"
                android:textStyle="bold"
                android:textColor="@color/dark_blue"
                android:textSize="16sp"
                app:layout_constraintTop_toTopOf="@id/avatar"
                app:layout_constraintBottom_toBottomOf="@id/avatar"
                app:layout_constraintStart_toStartOf="@id/avatar"
                app:layout_constraintEnd_toEndOf="@id/avatar"/>

            <!--Nombre del noticiero-->
            <TextView
                android:id="@+id/txtTitleHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Noticiero"
                android:textStyle="bold"
                android:textSize="16sp"
                app:layout_constraintStart_toEndOf="@id/avatar"
                app:layout_constraintTop_toTopOf="@id/avatar"
                android:layout_marginStart="12dp"/>

            <!-- Fecha -->
            <TextView
                android:id="@+id/txtDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Fecha"
                android:textSize="12sp"
                android:textColor="#757575"
                app:layout_constraintStart_toStartOf="@id/txtTitleHeader"
                app:layout_constraintTop_toBottomOf="@id/txtTitleHeader"
                app:layout_constraintEnd_toEndOf="@id/txtTitleHeader"/>

            <!-- Boton de tres puntos, tal vez se quita -->
            <ImageView
                android:id="@+id/btnThree"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_three_points"
                app:layout_constraintTop_toTopOf="@id/avatar"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Imagen principal sacada de la api -->
            <ImageView
                android:id="@+id/imgNews"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:background="@color/dark_blue"
                app:layout_constraintTop_toBottomOf="@id/avatar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp"/>

            <!-- Titulo de la noticia -->
            <TextView
                android:id="@+id/txtNewsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Título Noticia 1"
                android:textStyle="bold"
                android:textSize="18sp"
                app:layout_constraintTop_toBottomOf="@id/imgNews"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="12dp"/>

            <!-- Subtitulo -->
            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Subtítulo"
                android:textSize="14sp"
                android:textColor="#757575"
                app:layout_constraintTop_toBottomOf="@id/txtNewsTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="4dp"/>

            <!-- Descripcion -->
            <TextView
                android:id="@+id/txtDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit..."
                android:textSize="14sp"
                android:textColor="#616161"
                app:layout_constraintTop_toBottomOf="@id/txtSubtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"/>

            <!-- Boton que redigira al link original -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saber Más"
                android:textAllCaps="false"
                app:cornerRadius="24dp"
                app:layout_constraintTop_toBottomOf="@id/txtDescription"
                app:layout_constraintEnd_toEndOf="parent"
                android:backgroundTint="@color/dark_blue"
                android:layout_marginTop="12dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/noticia2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:strokeColor="#E0E0E0"
        app:strokeWidth="1dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/noticia1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- aqui vendra la imagen del noticiero -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/avatar2"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:backgroundTint="#D1C4E9"
                android:src="@android:color/transparent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!--De momento ponemos un text view-->
            <TextView
                android:id="@+id/txtInitial2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A"
                android:textStyle="bold"
                android:textColor="@color/dark_blue"
                android:textSize="16sp"
                app:layout_constraintTop_toTopOf="@id/avatar2"
                app:layout_constraintBottom_toBottomOf="@id/avatar2"
                app:layout_constraintStart_toStartOf="@id/avatar2"
                app:layout_constraintEnd_toEndOf="@id/avatar2"/>

            <!--Nombre del noticiero-->
            <TextView
                android:id="@+id/txtTitleHeader2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Noticiero"
                android:textStyle="bold"
                android:textSize="16sp"
                app:layout_constraintStart_toEndOf="@id/avatar2"
                app:layout_constraintTop_toTopOf="@id/avatar2"
                android:layout_marginStart="12dp"/>

            <!-- Fecha -->
            <TextView
                android:id="@+id/txtDate2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Fecha"
                android:textSize="12sp"
                android:textColor="#757575"
                app:layout_constraintStart_toStartOf="@id/txtTitleHeader2"
                app:layout_constraintTop_toBottomOf="@id/txtTitleHeader2"
                app:layout_constraintEnd_toEndOf="@id/txtTitleHeader2"/>

            <!-- Boton de tres puntos, tal vez se quita -->
            <ImageView
                android:id="@+id/btnThree2"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_three_points"
                app:layout_constraintTop_toTopOf="@id/avatar2"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Imagen principal sacada de la api -->
            <ImageView
                android:id="@+id/imgNews2"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:background="@color/dark_blue"
                app:layout_constraintTop_toBottomOf="@id/avatar2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp"/>

            <!-- Titulo de la noticia -->
            <TextView
                android:id="@+id/txtNewsTitle2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Título Noticia 2"
                android:textStyle="bold"
                android:textSize="18sp"
                app:layout_constraintTop_toBottomOf="@id/imgNews2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="12dp"/>

            <!-- Subtitulo -->
            <TextView
                android:id="@+id/txtSubtitle2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Subtítulo"
                android:textSize="14sp"
                android:textColor="#757575"
                app:layout_constraintTop_toBottomOf="@id/txtNewsTitle2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="4dp"/>

            <!-- Descripcion -->
            <TextView
                android:id="@+id/txtDescription2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit..."
                android:textSize="14sp"
                android:textColor="#616161"
                app:layout_constraintTop_toBottomOf="@id/txtSubtitle2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"/>

            <!-- Boton que redigira al link original -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMore2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saber Más"
                android:textAllCaps="false"
                app:cornerRadius="24dp"
                app:layout_constraintTop_toBottomOf="@id/txtDescription2"
                app:layout_constraintEnd_toEndOf="parent"
                android:backgroundTint="@color/dark_blue"
                android:layout_marginTop="12dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>


    </com.google.android.material.card.MaterialCardView>



