<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="?android:attr/actionBarSize"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="david.ceballos.helloworld.scenes.config.view.ConfigFragment">


    <LinearLayout
        android:id="@+id/header1"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ic_back_register"
            android:layout_width="20dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configuración"
            android:layout_marginLeft="105dp"
            android:gravity="center"
            android:textStyle="bold"
            android:textSize="20dp" />

        <ImageView
            android:id="@+id/ic_logo"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="90dp"
            android:layout_marginRight="6dp"
            android:src="@drawable/ic_logo_news" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/config1"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/header1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            android:gravity="start"
            android:text="Tema Claro"
            android:textSize="20dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_config1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.MySwitchBlue"
            android:checked="false" /> <!-- O true para iniciar activado -->
    </LinearLayout>

    <LinearLayout
        android:id="@+id/config2"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/config1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            android:gravity="start"
            android:text="Notificaciones"
            android:textSize="20dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_config2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.MySwitchBlue"
            android:checked="false" /> <!-- O true para iniciar activado -->
    </LinearLayout>

    <LinearLayout
        android:id="@+id/config3"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/config2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            android:gravity="start"
            android:text="Configuración 3"
            android:textSize="20dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_config3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.MySwitchBlue"
            android:checked="false" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>