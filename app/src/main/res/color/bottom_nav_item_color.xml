<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado: Cuando el ítem está seleccionado, usa el color primario del tema -->
    <item android:state_checked="true" android:color="@color/dark_blue" />

    <!-- Estado por defecto: Usa el color para texto/íconos sobre superficies -->
    <item android:state_checked="false" android:color="?attr/colorOnSurfaceVariant" />
</selector>
